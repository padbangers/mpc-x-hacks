{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "MPC X: Screenshot -> Downloads",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/mpcx-screenshot.ps1"
      ],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "MPC X: Record video -> Downloads",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/mpcx-record.ps1",
        "-Seconds", "${input:recSeconds}"
      ],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    }
  ],
  "inputs": [
    {
      "id": "recSeconds",
      "type": "promptString",
      "description": "MPC X Aufnahmedauer in Sekunden",
      "default": "20"
    }
  ]
}
